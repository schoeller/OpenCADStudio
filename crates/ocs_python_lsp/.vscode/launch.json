{
  // Attach the VS Code Python debugger to the OCS Python LSP worker.
  // The worker listens on the port passed to `ocs.debug.start(port)`.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to OCS Python LSP worker",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    }
  ]
}
